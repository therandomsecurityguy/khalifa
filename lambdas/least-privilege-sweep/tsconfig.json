{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleResolution": "node"
  },
  "include": [
    "../least-privilege-sweep/*.ts",
    "../shared/**/*",
    "../policy-evaluator/types.ts",
    "../policy-evaluator/policy-parser.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
