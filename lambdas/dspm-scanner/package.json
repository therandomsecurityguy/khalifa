{
  "name": "dspm-scanner",
  "version": "1.0.0",
  "private": true,
  "description": "Data Security Posture Management scanner for S3/RDS/DynamoDB data discovery",
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild index.ts --bundle --platform=node --format=cjs --target=node24 --outfile=dist/index.js --sourcemap --sources-content=false",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.ts\"",
    "format:check": "prettier --check \"**/*.ts\"",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@khalifa/risk-engine": "*",
    "@aws-sdk/client-lambda": "^3.1168.0",
    "@aws-sdk/client-s3": "^3.1168.0",
    "@aws-sdk/client-macie2": "^3.1168.0",
    "@aws-sdk/client-dynamodb": "^3.1168.0",
    "@aws-sdk/lib-dynamodb": "^3.1168.0",
    "@aws-sdk/util-dynamodb": "^3.996.2",
    "gremlin": "^3.8.2"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.131",
    "@types/jest": "^29.5.0",
    "@types/node": "^26.6.6",
    "jest": "^29.5.0",
    "ts-jest": "^29.4.15",
    "typescript": "^5.0.0",
    "eslint": "^8.56.0",
    "prettier": "^3.10.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3"
  }
}
