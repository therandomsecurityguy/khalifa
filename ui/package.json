{
  "name": "security-graph-ui",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "start": "next start",
    "lint": "eslint app lib types components --ext .ts,.tsx",
    "lint:fix": "eslint app lib types components --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "test": "cd .. && npx jest --selectProjects ui --runInBand"
  },
  "dependencies": {
    "next": "^16.4.2",
    "react": "^18.2.0",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.6",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.72.2",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.56.0",
    "eslint-config-next": "^15.5.25",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "jest-environment-jsdom": "^30.5.2",
    "postcss": "^8.5.28",
    "prettier": "^3.10.1",
    "@tailwindcss/postcss": "^4.3.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.0.0"
  }
}
