{
  "name": "api-service",
  "version": "1.0.0",
  "private": true,
  "description": "Security Graph API Service",
  "main": "dist/server.js",
  "scripts": {
    "build": "esbuild src/server.ts --bundle --platform=node --format=cjs --target=node24 --outfile=dist/server.js --sourcemap --sources-content=false",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "cd .. && jest --selectProjects api-service --passWithNoTests"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.450.0",
    "@aws-sdk/lib-dynamodb": "^3.450.0",
    "@aws-sdk/util-dynamodb": "^3.450.0",
    "@khalifa/integrations": "*",
    "@khalifa/risk-engine": "*",
    "compression": "^1.8.2",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "gremlin": "^3.8.2",
    "helmet": "^8.3.0",
    "jose": "^4.15.9"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/gremlin": "^3.6.7",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.2"
  }
}
