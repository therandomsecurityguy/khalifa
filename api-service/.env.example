# api-service environment
#
# Copy to `.env` for local development (gitignored) and adjust. Never commit
# real values — the deployment's runtime secret comes from AWS Secrets Manager
# through External Secrets, not from files. Missing required values fail fast:
# `/readyz` names exactly what is absent.

# Required to serve: bind address and the data plane.
PORT=8080
AWS_REGION=us-east-1
# Neptune cluster endpoint (hostname only; the client signs SigV4 requests).
NEPTUNE_ENDPOINT=cluster.example.neptune.amazonaws.com

# Required to authenticate: Cognito (JWT issuer) — or the Cloudflare Access
# pair below when the Access provider fronts the API.
COGNITO_USER_POOL_ID=us-east-1_EXAMPLE
COGNITO_CLIENT_ID=exampleclientid
COGNITO_REGION=us-east-1

# Optional: Cloudflare Access identity provider.
CLOUDFLARE_ACCESS_TEAM_DOMAIN=
CLOUDFLARE_ACCESS_AUD=
# Email domain the Access identity must match (exact verification, not suffix).
ACCESS_TRUSTED_EMAIL_DOMAIN=example.com
# Client ID (not the secret) of the Access service token allowed to call
# /compliance/reconciliation/publishable; empty accepts no one.
TRUST_CENTER_SYNC_CLIENT_ID=

# Browser origins allowed for CORS (comma-separated; empty disables CORS).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# DynamoDB tables. Defaults in code match the chart's values.yaml names; set
# these only when the deployment uses different names.
ISSUES_TABLE=SecurityIssues
EVIDENCE_TABLE=ComplianceEvidence
REPORTS_TABLE=ComplianceReports
ACCESS_ANALYZER_TABLE=AccessAnalyzerCache
LEAST_PRIVILEGE_TABLE=LeastPrivilegeFindings
AI_USE_CASES_TABLE=AiUseCases

# Collection schedule surfaced by the UI (cron expression and IANA timezone).
RULE_RUNNER_SCHEDULE=30 2-22/4 * * *
RULE_RUNNER_TIMEZONE=UTC
