{
  "name": "khalifa-cdk",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "watch": "tsc -w",
    "cdk": "cdk",
    "lint": "eslint lib bin --ext .ts",
    "format": "prettier --write \"lib/**/*.ts\" \"bin/**/*.ts\"",
    "format:check": "prettier --check \"lib/**/*.ts\" \"bin/**/*.ts\"",
    "test": "echo \"No tests specified\" && exit 0"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.268.0",
    "constructs": "^10.0.0",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.72.2",
    "aws-cdk": "^2.1148.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "prettier": "^3.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  }
}
