#     enabled   = true
#     className = "alb"
#     annotations = {
#       "alb.ingress.kubernetes.io/scheme"      = "internal"
#       "alb.ingress.kubernetes.io/target-type" = "ip"
#     }
#     hosts = [
#       {
#         host  = "khalifa.example.com"
#         paths = [{ path = "/", pathType = "Prefix", component = "ui" }]
#       },
#       {
#         host  = "api.khalifa.example.com"
#         paths = [{ path = "/", pathType = "Prefix", component = "api" }]
#       },
#     ]
#   }
