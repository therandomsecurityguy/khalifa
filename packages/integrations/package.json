{
  "name": "@khalifa/integrations",
  "version": "1.0.0",
  "private": true,
  "description": "Issue action sinks and auto-remediation for the Khalifa security graph",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1172.0",
    "@aws-sdk/client-sns": "^3.1172.0",
    "@aws-sdk/client-securityhub": "^3.1172.0",
    "@aws-sdk/client-ssm": "^3.1172.0",
    "@aws-sdk/client-dynamodb": "^3.1172.0",
    "@aws-sdk/lib-dynamodb": "^3.1172.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^26.6.6",
    "jest": "^29.5.0",
    "ts-jest": "^29.4.15",
    "typescript": "^5.0.0",
    "eslint": "^8.56.0",
    "prettier": "^3.10.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7"
  }
}
