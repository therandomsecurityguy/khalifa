{
  "name": "@khalifa/risk-engine",
  "version": "1.0.0",
  "private": true,
  "description": "Risk, attack-path, and compliance engine for the Khalifa security graph",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:lambda": "npm run build:risk-lambda && npm run build:compliance-lambda",
    "build:risk-lambda": "esbuild src/run-once.ts --bundle --platform=node --format=cjs --target=node24 --outfile=dist/lambda/index.js --sourcemap --sources-content=false",
    "build:compliance-lambda": "esbuild src/run-compliance-once.ts --bundle --platform=node --format=cjs --target=node24 --outfile=dist/compliance-lambda/index.js --sourcemap --sources-content=false",
    "typecheck": "tsc --noEmit",
    "start:runner": "node dist/run-once.js",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.400.0",
    "@aws-sdk/client-securityhub": "^3.1131.0",
    "@aws-sdk/client-sts": "^3.400.0",
    "@aws-sdk/credential-provider-node": "^3.972.83",
    "@aws-sdk/lib-dynamodb": "^3.400.0",
    "@aws-sdk/util-dynamodb": "^3.996.2",
    "@khalifa/integrations": "*",
    "@smithy/core": "^3.33.3",
    "@smithy/signature-v4": "^5.7.3",
    "gremlin": "^3.8.2"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.131",
    "@types/gremlin": "^3.6.7",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.5",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3"
  }
}
